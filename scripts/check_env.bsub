#!/bin/bash -l
#BSUB -J BH-000425-08-05-GemDepth-CheckEnv
#BSUB -o jobs/check_env.%J.stdout
#BSUB -e jobs/check_env.%J.stderr
#BSUB -q batch_h200
#BSUB -W 0:30
#BSUB -n 4
#BSUB -M 30240
#BSUB -gpu "num=1:aff=no"
#BSUB -U resv_cr_tfx_h200
#BSUB -m rng-dl01-w24n01

set -e
module purge
module load conda/4.8.5
module load cuda/12.4.0

PY=/home/izi2sgh/MYDATA/quanjie/liren/envs/gemdepth/bin/python
echo "=== Python ==="
$PY --version
echo "=== torch ==="
$PY -c "import torch; print(f'torch={torch.__version__}, cuda={torch.cuda.is_available()}, ngpu={torch.cuda.device_count()}')"
echo "=== flash-attn ==="
$PY -c "import flash_attn; print(f'flash-attn={flash_attn.__version__}')" 2>&1 || echo "flash-attn NOT installed"
echo "=== VKITTI ==="
ls /home/izi2sgh/MYDATA/quanjie/liren/datasets/vkitti_1.3.1/vkitti_1.3.1_rgb/ 2>&1 | head -3
ls /home/izi2sgh/MYDATA/quanjie/liren/datasets/vkitti_1.3.1/vkitti_1.3.1_depthgt/ 2>&1 | head -3
ls /home/izi2sgh/MYDATA/quanjie/liren/datasets/vkitti_1.3.1/vkitti_1.3.1_extrinsicsgt/ 2>&1 | head -3
echo "=== Pretrained ckpt ==="
ls -lh /home/izi2sgh/MYDATA/quanjie/liren/depth_baselines/GemDepth/checkpoint/gemdepth.pth 2>&1
echo "=== DONE ==="