#!/bin/bash -l
#BSUB -J BH-000425-08-05-GemDepth-Train-Stage1
#BSUB -o jobs/gemdepth_train_stage1.%J.stdout
#BSUB -e jobs/gemdepth_train_stage1.%J.stderr
#BSUB -q batch_h200
#BSUB -W 168:00
#BSUB -n 16
#BSUB -M 120000
#BSUB -gpu "num=8:aff=no"
#BSUB -U resv_cr_tfx_h200
#BSUB -m rng-dl01-w24n01

# Full training stage1 — 8 GPU × 100k steps, seq_len=32, bf16.
# REQUIRES:
#   - VKITTI 1.3.1 at $VKITTI_ROOT  (vkitti_1.3.1_{rgb,depthgt,extrinsicsgt})
#   - TartanAir at $TARTAN_ROOT     (scenes under */*/* with image_left/depth_left/pose_left.txt)
#
# Usage:
#   bsub < scripts/train_stage1.bsub               # fresh start
#   bsub < scripts/train_stage1.bsub -resume        # auto-resume from latest checkpoint

set -e
module purge
module load conda/4.8.5
module load cuda/12.4.0

PY=/home/izi2sgh/MYDATA/quanjie/liren/envs/gemdepth/bin/python
ROOT=/home/izi2sgh/MYDATA/quanjie/liren/depth_baselines/GemDepth
cd $ROOT
mkdir -p jobs logs/stage1

# Data dirs — set BEFORE submitting.
VKITTI_ROOT=/home/izi2sgh/MYDATA/quanjie/liren/datasets/vkitti_1.3.1/
TARTAN_ROOT=/home/izi2sgh/MYDATA/quanjie/liren/datasets/tartanair/

echo "[$(date)] start stage1" && nvidia-smi | head -15

# Build CLI args
CLI_ARGS=(
    --config-name stage1
    dataset.train.data_dirs="['$VKITTI_ROOT','$TARTAN_ROOT']"
    num_gpus=8
)

if [ "$1" == "-resume" ] || [ "$1" == "--resume" ]; then
    CLI_ARGS+=(resume=true)
    echo "[config] Auto-resume enabled"
fi

$PY -m accelerate.commands.launch \
    --num_processes 8 \
    --mixed_precision bf16 \
    train.py \
    "${CLI_ARGS[@]}"
echo "[$(date)] stage1 done"


