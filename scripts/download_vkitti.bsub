#!/bin/bash -l
#BSUB -J download-vkitti-1.3.1
#BSUB -o logs/download_vkitti.%J.stdout
#BSUB -e logs/download_vkitti.%J.stderr
#BSUB -q batch_cpu
#BSUB -W 24:00
#BSUB -n 1
#BSUB -M 50000

# Download VKITTI 1.3.1 from official Naver Labs URLs.
# Required by GemDepth training:
#   - vkitti_1.3.1_rgb.tar           (~14GB)
#   - vkitti_1.3.1_depthgt.tar       (~5.1GB)
#   - vkitti_1.3.1_extrinsicsgt.tar.gz (~1.1MB)

set -euo pipefail
module purge
module load conda/4.8.5

PY=/home/izi2sgh/MYDATA/quanjie/liren/envs/gemdepth/bin/python
ROOT=/home/izi2sgh/MYDATA/quanjie/liren/depth_baselines/GemDepth
TARGET_DIR=/home/izi2sgh/MYDATA/quanjie/liren/datasets/vkitti_1.3.1

cd $ROOT
mkdir -p logs "$TARGET_DIR"

echo "[$(date)] Starting official VKITTI 1.3.1 download"
echo "ROOT=$ROOT"
echo "TARGET_DIR=$TARGET_DIR"

$PY scripts/download_vkitti.py --target-dir "$TARGET_DIR" --keep-archives

echo "[$(date)] VKITTI download and extraction complete"
$PY scripts/download_vkitti.py --target-dir "$TARGET_DIR" --verify-only
