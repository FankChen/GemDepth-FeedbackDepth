#!/bin/bash -l
#BSUB -J BH-000425-08-05-GemDepth-Train-Stage2
#BSUB -o jobs/gemdepth_train_stage2.%J.stdout
#BSUB -e jobs/gemdepth_train_stage2.%J.stderr
#BSUB -q batch_h200
#BSUB -W 168:00
#BSUB -n 16
#BSUB -M 120000
#BSUB -gpu "num=8:aff=no"

# Stage2 — fine-tune from stage1 checkpoint.
# model.video_path should point to the stage1 final checkpoint.
#
# Usage:
#   bsub < scripts/train_stage2.bsub                # fresh start from stage1 ckpt
#   bsub < scripts/train_stage2.bsub -resume         # auto-resume from stage2 intermediate ckpt

set -e
module purge
module load conda/4.8.5
module load cuda/12.4.0

PY=/home/izi2sgh/MYDATA/quanjie/liren/envs/gemdepth/bin/python
ROOT=/home/izi2sgh/MYDATA/quanjie/liren/depth_baselines/GemDepth
cd $ROOT
mkdir -p jobs logs/stage2

VKITTI_ROOT=/home/izi2sgh/MYDATA/quanjie/liren/datasets/vkitti_1.3.1/
TARTAN_ROOT=/home/izi2sgh/MYDATA/quanjie/liren/datasets/tartanair/
STAGE1_CKPT=$ROOT/checkpoint/gemdepth_stage1/final.pth

echo "[$(date)] start stage2" && nvidia-smi | head -15

# Build CLI args
CLI_ARGS=(
    --config-name stage2
    dataset.train.data_dirs="['$VKITTI_ROOT','$TARTAN_ROOT']"
    model.video_path="$STAGE1_CKPT"
    num_gpus=8
)

if [ "$1" == "-resume" ] || [ "$1" == "--resume" ]; then
    CLI_ARGS+=(resume=true)
    echo "[config] Auto-resume enabled for stage2"
fi

$PY -m accelerate.commands.launch \
    --num_processes 8 \
    --mixed_precision bf16 \
    train.py \
    "${CLI_ARGS[@]}"
echo "[$(date)] stage2 done"


