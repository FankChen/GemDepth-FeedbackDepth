#!/bin/bash -l
#BSUB -J BH-000425-08-05-GemDepth-Infer-Bonn
#BSUB -o jobs/gemdepth_infer_bonn.%J.stdout
#BSUB -e jobs/gemdepth_infer_bonn.%J.stderr
#BSUB -q batch_a100
#BSUB -W 4:00
#BSUB -n 8
#BSUB -M 60480
#BSUB -gpu "num=1:aff=no"

set -e
module purge
module load conda/4.8.5
module load cuda/12.4.0

GEMDEPTH_PY=/home/izi2sgh/MYDATA/quanjie/liren/envs/gemdepth/bin/python
GEMDEPTH_ROOT=/home/izi2sgh/MYDATA/quanjie/liren/depth_baselines/GemDepth
EVAL_ROOT=/home/izi2sgh/MYDATA/quanjie/liren/datasets/gemdepth_eval
OUT_ROOT=$GEMDEPTH_ROOT/output_eval

mkdir -p $OUT_ROOT $GEMDEPTH_ROOT/jobs
cd $GEMDEPTH_ROOT

JSON=$EVAL_ROOT/bonn/bonn_video_500.json

echo "[$(date)] Start Bonn inference"
echo "JSON     = $JSON"
echo "OUT_ROOT = $OUT_ROOT"
nvidia-smi | head -15

$GEMDEPTH_PY evaluation/inference/infer.py \
    --infer_path $OUT_ROOT \
    --json_file $JSON \
    --datasets bonn \
    --input_size 518 \
    --encoder vitl

echo "[$(date)] Bonn inference done"

echo "[$(date)] Start evaluation"
$GEMDEPTH_PY evaluation/eval/eval.py \
    --infer_path $OUT_ROOT \
    --benchmark_path $EVAL_ROOT \
    --datasets bonn_500

echo "[$(date)] Bonn eval done"