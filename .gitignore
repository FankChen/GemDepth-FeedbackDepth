# Python artifacts
__pycache__
*.pyc
*.pyo
*.pyd

outputs

# Virtual environment
venv
.env

# Checkpoints and outputs
# No trailing slash: a trailing "/" matches ONLY real directories, so a symlink
# named e.g. `checkpoint` (pointing at real data on another disk) would NOT be
# ignored, could get tracked, and a later checkout could clobber the linked data.
# Slashless patterns match files, dirs AND symlinks, so the symlink stays ignored.
checkpoint
jobs
output_eval

# Logs
*.log
logs

# OS files
.DS_Store
